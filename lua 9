            end
        end
    end
end)

-- Get weapons (Prison Life TouchGiver)
local gettingWeapon = false
local function getWeapon(ToolName)
    if gettingWeapon then return end
    gettingWeapon = true
    local Char = LocalPlayer.Character
    local Root = Char and Char:FindFirstChild("HumanoidRootPart")
    if not (Char and Root) then gettingWeapon = false return end
    if Char:FindFirstChild("ForceField") then gettingWeapon = false return end
    if LocalPlayer.Backpack:FindFirstChild(ToolName) or Char:FindFirstChild(ToolName) then
        gettingWeapon = false
        return
    end
    local Giver
    for _, v in ipairs(workspace:GetDescendants()) do
        if v.Name == "TouchGiver" and v:GetAttribute("ToolName") == ToolName then
            Giver = v:FindFirstChildWhichIsA("BasePart")
            break
        end
    end
    if not Giver then gettingWeapon = false; notify("No giver for " .. tostring(ToolName)); return end
    local OriginalGiverCFrame = Giver.CFrame
    local UndergroundCFrame = OriginalGiverCFrame - Vector3.new(0, 15.5, 0)
    Giver.CanTouch = true
    Giver.CFrame = UndergroundCFrame
    Root.Anchored = true
    Char:PivotTo(UndergroundCFrame + Vector3.new(0, 5, 0))
    task.wait(0.25)
    pcall(function() firetouchinterest(Giver, Root, 0) end)
    task.wait(0.3)
    pcall(function() firetouchinterest(Giver, Root, 1) end)
    if Giver and Giver.Parent then Giver.CFrame = OriginalGiverCFrame end
    local function HasWeapon()
        Char = LocalPlayer.Character
        return LocalPlayer.Backpack:FindFirstChild(ToolName) ~= nil or (Char and Char:FindFirstChild(ToolName) ~= nil)
    end
    local Obtained, Elapsed = false, 0
    while Elapsed < 4 do
        if HasWeapon() then Obtained = true break end
        task.wait(0.1); Elapsed = Elapsed + 0.1
    end
    Root.Anchored = false
    gettingWeapon = false
    notify(Obtained and ("Got " .. ToolName) or ("Failed " .. ToolName))
end
getgenv().GetWeapons = function()
    local list = SilentAimSettings.GetWeaponsList or {}
    task.spawn(function()
        for _, name in ipairs(list) do
            getWeapon(name)
            task.wait(0.4)
        end
    end)
end
task.spawn(function()
    while task.wait(8) do
        if SilentAimSettings.AutoGetWeapons then
            pcall(getgenv().GetWeapons)
        end
    end
end)

