-- Tip offset: ring center sits on the true mouse tip (hotspot), not image corner
local CURSOR_TIP_OFFSET = Vector2.new(0, 0)

local function invertColor(c)
    return Color3.new(1 - c.R, 1 - c.G, 1 - c.B)
end

local function sampleUnderCursor(screenPos)
    -- Ray into world under the tip; use hit color or sky heuristic for invert pair
    local cam = workspace.CurrentCamera
    if not cam then
        return Color3.fromRGB(255, 255, 255)
    end
    local ray = cam:ViewportPointToRay(screenPos.X, screenPos.Y)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local char = LocalPlayer.Character
    if char then params.FilterDescendantsInstances = { char } end
    local result = workspace:Raycast(ray.Origin, ray.Direction * 500, params)
    if result and result.Instance then
        local inst = result.Instance
        local col = nil
        pcall(function()
            if inst:IsA("BasePart") then
                col = inst.Color
            end
        end)
        if col then return col end
    end
    -- No hit: alternate soft sky-ish sample so invert still contrasts
    return Color3.fromRGB(40, 40, 48)
end

