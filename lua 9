function matchesTeam(Player)
    if not _origMatchesTeam(Player) then return false end
    if SilentAimSettings.FriendCheck then
        local ok, friends = pcall(function() return LocalPlayer:IsFriendsWith(Player.UserId) end)
        if ok and friends then return false end
    end
    if Player.Team and SilentAimSettings.TargetTeams then
        local tn = Player.Team.Name
        if SilentAimSettings.TargetTeams[tn] == false then return false end
    end
    return true
end

function matchesTargetingMode(Player)
    if SilentAimSettings.HostileCheck or SilentAimSettings.TrespassCheck then
        local modeHostile = SilentAimSettings.HostileCheck
        local modeTrespass = SilentAimSettings.TrespassCheck
        if Player.Team and Player.Team.Name == "Inmates" then
            local char = Player.Character
            if not char then return false end
            local hostile = char:GetAttribute("Hostile") == true
            local trespass = char:GetAttribute("Trespassing") == true
            if modeHostile and modeTrespass then
                if not hostile and not trespass then return false end
            elseif modeHostile then
                if not hostile then return false end
            elseif modeTrespass then
                if not trespass then return false end
            end
        end
    end
    return _origMatchesMode(Player)
end

