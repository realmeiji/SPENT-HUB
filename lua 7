-- ── INVISIBLE ─────────────────────────────────────────────────────────────────
local invRenderKey = "SpentInvisible"
local invAnimTrack = nil
local invRealCF    = nil
local invOrigTrans = {}
local invOrigCC    = {}

local function loadInvAnim(char)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    local anim = Instance.new("Animation")
    anim.AnimationId = hum.RigType == Enum.HumanoidRigType.R15
        and "rbxassetid://18665825805"
        or  "rbxassetid://215384594"
    local anim2 = hum:LoadAnimation(anim)
    anim2.Priority = Enum.AnimationPriority.Action4
    anim2:Play(0, 0.001, 0)
    anim:Destroy()
    task.delay(0, function() anim2.TimePosition = hum.RigType == Enum.HumanoidRigType.R15 and 1.95 or 0.4 end)
    return anim2
end

local function stopInvisible()
    pcall(function() RunService:UnbindFromRenderStep(invRenderKey) end)
    if invAnimTrack then invAnimTrack:Stop(); invAnimTrack:Destroy(); invAnimTrack = nil end
    local c = LocalPlayer.Character
    local r = c and c:FindFirstChild("HumanoidRootPart")
    if r and invRealCF then
        r.CFrame = invRealCF
        local v = r.AssemblyLinearVelocity
        r.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
    end
    invRealCF = nil
    if c then
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") and p ~= r then
                if invOrigTrans[p] ~= nil then p.Transparency = invOrigTrans[p] end
                if invOrigCC[p]    ~= nil then p.CanCollide   = invOrigCC[p]    end
            end
        end
        if r then r.Transparency = 0 end
    end
    table.clear(invOrigTrans); table.clear(invOrigCC)
end

local function startInvisible()
    local c = LocalPlayer.Character
    if not c then return end
    local hum = c:FindFirstChildOfClass("Humanoid")
    local r   = c:FindFirstChild("HumanoidRootPart")
    if not (hum and r) then return end
    invAnimTrack = loadInvAnim(c)
    table.clear(invOrigTrans); table.clear(invOrigCC)
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") and p ~= r then
            invOrigTrans[p] = p.Transparency
            invOrigCC[p]    = p.CanCollide
            p.Transparency  = 0.5
            p.CanCollide    = false
        end
    end
    r.Transparency = 1
    pcall(function() RunService:UnbindFromRenderStep(invRenderKey) end)
    RunService:BindToRenderStep(invRenderKey, Enum.RenderPriority.Camera.Value - 1, function()
        if S.InvisibleEnabled and invRealCF and r.Parent then
            r.CFrame = invRealCF
            if invAnimTrack then invAnimTrack:AdjustWeight(0.001) end
        end
    end)
end

RunService.Heartbeat:Connect(function()
    if not S.InvisibleEnabled then return end
    local c = LocalPlayer.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    local r = c and c:FindFirstChild("HumanoidRootPart")
    if not (h and r) then return end
    local isR15 = h.RigType == Enum.HumanoidRigType.R15
    local drop  = h.HipHeight + (r.Size.Y / 2) - 1
    invRealCF   = r.CFrame
    r.CFrame    = (r.CFrame - Vector3.new(0, drop, 0)) * CFrame.Angles(math.rad(isR15 and 180 or 90), 0, 0)
    local v     = r.AssemblyLinearVelocity
    r.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
    if invAnimTrack then invAnimTrack:AdjustWeight(100) end
end)

