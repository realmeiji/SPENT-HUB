    end)
end

-- ── AUTOSHOOT ────────────────────────────────────────────────────────────────
local autoShootParams = RaycastParams.new()
autoShootParams.FilterType       = Enum.RaycastFilterType.Exclude
autoShootParams.CollisionGroup   = "ClientBullet"
local autoShootInProgress = false
local lastAutoShot = {}
local gunNames = {"AK-47","Remington 870","M9","M700","M4A1","FAL","MP5","Revolver","Taser"}

local function castPellet(weapon, origin, aim, spread)
    local range = weapon:GetAttribute("Range") or 1000
    local behavior = weapon:GetAttribute("Behavior")
    local roll = math.random()
    if behavior == "Sniper" or behavior == "Shotgun" then roll = math.sqrt(roll) end
    local lCF = CFrame.new(origin, aim)
    local dir = (lCF * CFrame.Angles(0,0,math.rad(360-720*math.random())) * CFrame.Angles(0, roll*spread, 0)).LookVector * range
    autoShootInProgress = true
    local res = workspace:Raycast(origin, dir, autoShootParams)
    autoShootInProgress = false
    return res and res.Instance or nil, res and res.Position or (origin+dir)
end

RunService.Heartbeat:Connect(function()
    if not (S.Enabled and S.AutoshootEnabled and shootRemote) then return end
    if not currentTarget or not currentTarget.Parent then return end
    local c   = LocalPlayer.Character
    local hum = c and c:FindFirstChildOfClass("Humanoid")
    if not (hum and hum.Health > 0) then return end
    local weapon = getEquippedWeapon()
    if not weapon or not table.find(gunNames, weapon.Name) then return end
    local fireRate  = weapon:GetAttribute("FireRate") or 0.1
    local lastShot  = lastAutoShot[weapon.Name] or 0
    if (tick() - lastShot) < fireRate then return end
    if weapon:GetAttribute("Local_ReloadSession") ~= 0 then return end
    local ammo = weapon:GetAttribute("Local_CurrentAmmo") or 0
    if ammo <= 0 then return end
    local head = c:FindFirstChild("Head")
    if not head then return end
    autoShootParams.FilterDescendantsInstances = {c}
    local origin   = head.Position
    local aimPoint = currentTarget.Position
    local spread   = weapon:GetAttribute("SpreadRadius") or 0
    local count    = weapon:GetAttribute("ProjectileCount") or 1
    local muzzle   = weapon:FindFirstChild("Muzzle")
    local muzzlePos= muzzle and muzzle.Position or origin
    local bullets  = {}
    for _ = 1, count do
        local hi, hp = castPellet(weapon, origin, aimPoint, spread)
        table.insert(bullets, {origin, hp, hi})
        if AutoShootTracers then
            pcall(function()
                local b = weapon:GetAttribute("Behavior")
                if b == "Sniper"   then AutoShootTracers.createSniper(muzzlePos, hp)
                elseif b == "Taser" then AutoShootTracers.createTaser(muzzlePos, hp)
                else AutoShootTracers.createBullet(muzzlePos, hp) end
            end)
        end
    end
    shootRemote:FireServer(bullets)
    lastAutoShot[weapon.Name] = tick()
    local newAmmo = ammo - 1
    weapon:SetAttribute("Local_CurrentAmmo", newAmmo)
    -- play sound + flash muzzle flash locally
    pcall(function()
        local handle = weapon:FindFirstChild("Handle")
        if handle then
            local ss = handle:FindFirstChild("ShootSound")
            if ss and S.PreserveSoundsEnabled then
                local cl = ss:Clone(); cl.Parent = Camera; cl.Playing = true
                task.delay(5, function() pcall(function() cl:Destroy() end) end)
            elseif ss then
                ss:Play()
            end
            local fl = handle:FindFirstChild("Flare")
            if fl then fl.Enabled = true; task.delay(0.05, function() if fl then fl.Enabled = false end end) end
        end
    end)
end)

