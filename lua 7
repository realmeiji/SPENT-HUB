local ExpArgs = {
    FindPartOnRayWithIgnoreList  = {req=3, args={"Instance","Ray","table","boolean","boolean"}},
    FindPartOnRayWithWhitelist   = {req=3, args={"Instance","Ray","table","boolean"}},
    FindPartOnRay                = {req=2, args={"Instance","Ray","Instance","boolean","boolean"}},
    Raycast                      = {req=3, args={"Instance","Vector3","Vector3","RaycastParams"}},
}
local function validateArgs(args, spec)
    if #args < spec.req then return false end
    local n = 0
    for i, a in next, args do
        if typeof(a) == spec.args[i] then n = n + 1 end
    end
    return n >= spec.req
end

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(...)
    local Method = getnamecallmethod()
    local Args   = {...}
    local self   = Args[1]

    -- Preserve sounds hook (redundant safety net)
    if Method == "Play" and not checkcaller() and S.PreserveSoundsEnabled then
        local ok, isSnd = pcall(function() return self.ClassName == "Sound" end)
        if ok and isSnd then
            local tool = self.Parent and self.Parent.Parent
            local lc   = LocalPlayer.Character
            if lc and tool and tool.Parent == lc and tool:IsA("Tool")
                and tool:GetAttribute("ToolType") == "Gun" then
                pcall(function()
                    local cl = self:Clone(); cl.Parent = Camera; cl.Playing = true
                    task.delay(math.max(self.TimeLength, 5), function()
                        pcall(function() cl:Destroy() end)
                    end)
                end)
                return
            end
        end
    end

    local chance = rollChance()
    if S.Enabled and self == workspace and not checkcaller() and chance and not autoShootInProgress then
        local hit = currentTarget
        if hit and hit.Parent then
            if Method == "Raycast" and S.SilentAimMethod == "Raycast" then
                if validateArgs(Args, ExpArgs.Raycast) then
                    Args[3] = getDirection(Args[2], hit.Position)
                    return oldNamecall(table.unpack(Args))
                end
            elseif Method == "FindPartOnRayWithIgnoreList" and S.SilentAimMethod == Method then
                if validateArgs(Args, ExpArgs.FindPartOnRayWithIgnoreList) then
                    local r = Args[2]
                    Args[2] = Ray.new(r.Origin, getDirection(r.Origin, hit.Position))
                    return oldNamecall(table.unpack(Args))
                end
            elseif Method == "FindPartOnRayWithWhitelist" and S.SilentAimMethod == Method then
                if validateArgs(Args, ExpArgs.FindPartOnRayWithWhitelist) then
                    local r = Args[2]
                    Args[2] = Ray.new(r.Origin, getDirection(r.Origin, hit.Position))
                    return oldNamecall(table.unpack(Args))
                end
            elseif (Method == "FindPartOnRay" or Method == "findPartOnRay")
                and S.SilentAimMethod:lower() == Method:lower() then
                if validateArgs(Args, ExpArgs.FindPartOnRay) then
                    local r = Args[2]
                    Args[2] = Ray.new(r.Origin, getDirection(r.Origin, hit.Position))
                    return oldNamecall(table.unpack(Args))
                end
            end
        end
    end
    return oldNamecall(...)
end))

local oldIndex
oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, i)
    if self == Mouse and not checkcaller() and S.Enabled
        and S.SilentAimMethod == "Mouse.Hit/Target"
        and currentTarget and currentTarget.Parent then
        local hit = currentTarget
        if i == "Target" or i == "target" then return hit end
        if i == "Hit"    or i == "hit"    then
            return S.MouseHitPrediction
                and hit.CFrame + (hit.Velocity * PredictionAmount)
                or hit.CFrame
        end
        if i == "X" or i == "x" then return self.X end
        if i == "Y" or i == "y" then return self.Y end
        if i == "UnitRay" then
            return Ray.new(self.Origin, (self.Hit - self.Origin).Unit)
        end
    end
    return oldIndex(self, i)
end))

