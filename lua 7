-- ── GLOBAL KEYBINDS ───────────────────────────────────────────────────────────
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    -- Silent Aim toggle
    if input.KeyCode == Enum.KeyCode.RightAlt then
        S.Enabled = not S.Enabled
        Library:Notify("Silent Aim: "..(S.Enabled and "ON" or "OFF"), 2)
    end
    -- Noclip punch
    if input.KeyCode == Enum.KeyCode.F and S.NoclipPunchEnabled then
        task.delay(0.35, startPunch)
    end
    -- Auto Reload hotkey
    if input.KeyCode == S.AutoReloadHotkey and S.AutoReloadEnabled then
        reloadAll()
        Library:Notify("Reloaded all weapons", 2)
    end
    -- Fast Switch hotkey
    if input.KeyCode == S.FastSwitchHotkey then
        S.FastSwitchEnabled = not S.FastSwitchEnabled
        if S.FastSwitchEnabled then startFastSwitch() else stopFastSwitch() end
        Library:Notify("Fast Switch: "..(S.FastSwitchEnabled and "ON" or "OFF"), 2)
    end
    -- Unload
    if input.KeyCode == Enum.KeyCode.End then
        UserInputService.MouseIconEnabled = origMouseIcon
        pcall(function() curGui:Destroy() end)
        if curConn then curConn:Disconnect() end
        stopNoclip(); stopPunch(); stopInvisible(); stopFastSwitch(); stopPreserveSounds()
        for _, p in ipairs(Players:GetPlayers()) do removeESP(p) end
        pcall(function() fovCircle:Remove() end)
        pcall(function() targetBox:Remove() end)
        Library:Destroy()
        print("SpentHub unloaded.")
    end
end)

