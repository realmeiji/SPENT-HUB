-- ── PRISON LIFE REMOTE SCAN ───────────────────────────────────────────────────
-- Scans RS at load; re-scans on CharacterAdded
local shootRemote       = nil
local reloadRemote      = nil
local AutoShootTracers  = nil

local function scanRemotes()
    pcall(function()
        local gr = ReplicatedStorage:WaitForChild("GunRemotes", 5)
        if gr then
            shootRemote  = gr:FindFirstChild("ShootEvent")  or gr:FindFirstChild("Shoot")
            reloadRemote = gr:FindFirstChild("ReloadEvent") or gr:FindFirstChild("Reload")
        end
    end)
    pcall(function()
        local sm = ReplicatedStorage:FindFirstChild("SharedModules")
        if sm then
            local gt = sm:FindFirstChild("GunTracers")
            if gt then AutoShootTracers = require(gt) end
        end
    end)
    -- attribute names Prison Life uses
    -- CurrentAmmo / MaxAmmo / StoredAmmo / FireRate / AutoFire / Behavior
    -- ProjectileCount / SpreadRadius / Range
end
task.spawn(scanRemotes)

-- ── HELPERS ───────────────────────────────────────────────────────────────────
local ValidTargetParts  = {"Head","HumanoidRootPart"}
local PredictionAmount  = 0.165
local TARGET_COLOR      = Color3.fromRGB(255, 200, 220)
local RING_IDLE         = Color3.fromRGB(255, 255, 255)

local function getScreenPos(v3)
    local v, on = Camera:WorldToViewportPoint(v3)
    if v.Z < 0 then return Vector2.new(), false end
    return Vector2.new(v.X, v.Y), on
end

local function getCenter()
    local vp = Camera.ViewportSize
    return Vector2.new(vp.X/2, vp.Y/2)
end

local function getCursor()
    if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
        return getCenter()
    end
    return UserInputService:GetMouseLocation()
end

local function getAimOrigin()
    return S.FOVCenter and getCenter() or getCursor()
end

local function getDirection(origin, pos)
    return (pos - origin).Unit * 1000
end

local function HasForcefield(p)
    local c = p.Character
    return c and c:FindFirstChildOfClass("ForceField") ~= nil
end

local function IsVisible(p)
    local pc = p.Character
    local lc = LocalPlayer.Character
    if not (pc and lc) then return false end
    local r = pc:FindFirstChild(S.TargetPart) or pc:FindFirstChild("HumanoidRootPart")
    if not r then return false end
    return #Camera:GetPartsObscuringTarget({r.Position, lc, pc}, {lc, pc}) == 0
end

local function matchTeam(p)
    local t = p.Team
    if not t then return true end
    local n = t.Name
    if n == "Guards"    and not S.TargetCop     then return false end
    if n == "Inmates"   and not S.TargetInmate   then return false end
    if n == "Criminals" and not S.TargetCriminal then return false end
    return true
end

local function matchMode(p)
    local mode = S.TargetingMode
    if mode == "Manual" then return true end
    local c = p.Character
    if not c then return false end
    if mode == "Hostile"     then return c:GetAttribute("Hostile")     == true end
    if mode == "Trespassing" then return c:GetAttribute("Trespassing") == true end
    return true
end

local function getTeamColor(p)
    local ok, col = pcall(function()
        if p.Team and p.Team.TeamColor then return p.Team.TeamColor.Color end
        local c = p.Character
        if c then
            local bc = c:FindFirstChildOfClass("BodyColors")
            if bc then return bc.HeadColor3 end
        end
    end)
    return (ok and col) or S.ESP_HighlightColor
end

local function getEquippedWeapon()
    local c = LocalPlayer.Character
    if not c then return nil end
    for _, v in ipairs(c:GetChildren()) do
        if v:IsA("Tool") then return v end
    end
end

-- ── SILENT AIM TARGET ────────────────────────────────────────────────────────
local currentTarget = nil

local function getClosest()
    local best, bestDist
    local origin = getAimOrigin()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer        then continue end
        if isWhitelisted(p)        then continue end
        if S.TeamCheck and p.Team == LocalPlayer.Team then continue end
        if not matchTeam(p)        then continue end
        if S.ForcefieldCheck and HasForcefield(p) then continue end
        if not matchMode(p)        then continue end
        local c = p.Character
        if not c then continue end
        if S.VisibleCheck and not IsVisible(p) then continue end
        local hrp = c:FindFirstChild("HumanoidRootPart")
        local hum = c:FindFirstChildOfClass("Humanoid")
        if not (hrp and hum) or hum.Health <= 0 then continue end
        local sp, on = getScreenPos(hrp.Position)
        if not on then continue end
        local d = (origin - sp).Magnitude
        if d <= (bestDist or S.FOVRadius or 2000) then
            local part
            if S.TargetPart == "Random" then
                part = c[ValidTargetParts[math.random(1,#ValidTargetParts)]]
            else
                part = c[S.TargetPart]
            end
            best = part
            bestDist = d
        end
    end
    return best
end

task.spawn(function()
    while task.wait(0.1) do
        currentTarget = S.Enabled and getClosest() or nil
    end
end)

