-- ── PRESERVE SOUNDS ───────────────────────────────────────────────────────────
-- Clones any gun tool sound to Camera before the tool plays it;
-- the clone plays freely even after tool is unequipped/swapped.
local preserveConn = nil

local function startPreserveSounds()
    if preserveConn then return end
    preserveConn = LocalPlayer.Character and LocalPlayer.Character.ChildAdded:Connect(function(child)
        if not S.PreserveSoundsEnabled then return end
        if not child:IsA("Tool") then return end
        local handle = child:FindFirstChild("Handle")
        if not handle then return end
        handle.ChildAdded:Connect(function(sound)
            if not sound:IsA("Sound") then return end
            sound.Played:Connect(function()
                if not S.PreserveSoundsEnabled then return end
                pcall(function()
                    local clone = sound:Clone()
                    clone.Parent  = Camera
                    clone.Playing = true
                    task.delay(math.max(sound.TimeLength, 5), function()
                        pcall(function() clone:Destroy() end)
                    end)
                end)
            end)
        end)
    end)
end

local function stopPreserveSounds()
    if preserveConn then preserveConn:Disconnect() preserveConn = nil end
end

-- ── AUTO RELOAD ───────────────────────────────────────────────────────────────
-- Prison Life stores CurrentAmmo + MaxAmmo as tool Attributes.
-- Reload remote: ReplicatedStorage.GunRemotes.ReloadEvent (or Reload).
-- Fallback: set Local_CurrentAmmo directly + fire remote if present.
local function reloadWeapon(weapon)
    if not weapon then return end
    local maxAmmo = weapon:GetAttribute("MaxAmmo") or weapon:GetAttribute("StoredAmmo") or 30
    -- set local ammo attr instantly
    pcall(function() weapon:SetAttribute("Local_CurrentAmmo", maxAmmo) end)
    pcall(function() weapon:SetAttribute("Local_ReloadSession", 0) end)
    -- fire reload remote if found
    if reloadRemote then
        pcall(function() reloadRemote:FireServer(weapon) end)
    else
        -- scan again in case it loaded late
        scanRemotes()
        if reloadRemote then
            pcall(function() reloadRemote:FireServer(weapon) end)
        end
    end
end

local function reloadAll()
    local c = LocalPlayer.Character
    if not c then return end
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    local tools = {}
    if backpack then
        for _, v in ipairs(backpack:GetChildren()) do
            if v:IsA("Tool") then table.insert(tools, v) end
        end
    end
    for _, v in ipairs(c:GetChildren()) do
        if v:IsA("Tool") then table.insert(tools, v) end
    end
    for _, weapon in ipairs(tools) do
        task.delay(0, function()
            task.wait(0.3 / 1000) -- 0.3ms
            reloadWeapon(weapon)
        end)
    end
end

