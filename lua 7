    d.hl = Instance.new("Highlight")
    d.hl.FillColor         = S.ESP_HighlightColor
    d.hl.OutlineColor      = S.ESP_HighlightColor
    d.hl.FillTransparency  = 0.55
    d.hl.OutlineTransparency = 0
    d.hl.DepthMode         = Enum.HighlightDepthMode.AlwaysOnTop
    d.hl.Enabled           = false
    return d
end

local function hideESP(d)
    if not d then return end
    d.name.Visible  = false
    d.hp.Visible    = false
    d.hpbg.Visible  = false
    d.trace.Visible = false
    if d.hl then d.hl.Enabled = false end
end

local function removeESP(p)
    local d = espData[p]; if not d then return end
    pcall(function() d.name:Remove()  end)
    pcall(function() d.hp:Remove()    end)
    pcall(function() d.hpbg:Remove()  end)
    pcall(function() d.trace:Remove() end)
    pcall(function() d.hl:Destroy()   end)
    espData[p] = nil
end

local function updateESP()
    if not S.ESP_Enabled then
        for _, d in pairs(espData) do hideESP(d) end; return
    end
    local myC   = LocalPlayer.Character
    local myR   = myC and myC:FindFirstChild("HumanoidRootPart")
    local camP  = myR and myR.Position or Camera.CFrame.Position
    local vp    = Camera.ViewportSize
    local maxD  = S.ESP_MaxDistance
    local myT   = LocalPlayer.Team

    table.clear(espCache)
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local c = p.Character
        local h = c and c:FindFirstChildOfClass("Humanoid")
        local r = c and c:FindFirstChild("HumanoidRootPart")
        if c and h and r and h.Health > 0 then
            espCache[p] = {c=c, h=h, r=r, head=c:FindFirstChild("Head")}
        end
    end

    for p, info in pairs(espCache) do
        local c, h, r, head = info.c, info.h, info.r, info.head
        local d = espData[p]
        if not d then d = newESPEntry(); espData[p] = d end

        if S.ESP_Team and p.Team == myT then hideESP(d); continue end

        local dist = (r.Position - camP).Magnitude
        if dist > maxD then hideESP(d); continue end

        local headPos = head and head.Position or (r.Position + Vector3.new(0,2.5,0))
        local feetPos = r.Position - Vector3.new(0,2.8,0)
        local hv = Camera:WorldToViewportPoint(headPos)
        local fv = Camera:WorldToViewportPoint(feetPos)
        if hv.Z<=0 and fv.Z<=0 then hideESP(d); continue end

        local hs = Vector2.new(hv.X, hv.Y)
        local fs = Vector2.new(fv.X, fv.Y)
        local midX = hv.Z>0 and hs.X or fs.X
        if midX < -200 or midX > vp.X+200 then hideESP(d); continue end

        local bh    = math.clamp(math.abs(hs.Y-fs.Y), 12, 400)
        local topY  = math.min(hs.Y, fs.Y)
        local botY  = topY + bh

        -- Highlight
        if S.ESP_Highlight then
            local isLocked = currentTarget and currentTarget.Parent == c
            local col = isLocked and TARGET_COLOR
                or (S.ESP_Team and getTeamColor(p) or S.ESP_HighlightColor)
            if d.hl.Adornee ~= c then d.hl.Adornee = c end
            if d.hl.Parent  ~= c then d.hl.Parent  = c end
            d.hl.FillColor    = col
            d.hl.OutlineColor = col
            d.hl.Enabled      = true
        else
            d.hl.Enabled = false
        end

        -- Name
        if S.ESP_Name then
            d.name.Visible   = true
            d.name.Text      = string.format("%s [%d]", p.Name, math.floor(dist))
            d.name.Color     = Color3.fromRGB(255,255,255)
            d.name.Size      = math.clamp(13 - dist/120, 8, 14)
            d.name.Position  = Vector2.new(midX, topY - 16)
        else d.name.Visible = false end

        -- Health bar
        if S.ESP_Health then
            local pct = math.clamp(h.Health / math.max(h.MaxHealth,1), 0, 1)
            local bwd = math.max(3, math.min(6, bh*0.06))
            local bx  = midX - (bh*0.275) - bwd - 4
            d.hpbg.Visible = true
            d.hpbg.Position= Vector2.new(bx, topY)
            d.hpbg.Size    = Vector2.new(bwd, bh)
            d.hpbg.Color   = Color3.fromRGB(20,20,20)
            local fh = bh * pct
            d.hp.Visible   = true
            d.hp.Position  = Vector2.new(bx, botY - fh)
            d.hp.Size      = Vector2.new(bwd, fh)
            d.hp.Color     = Color3.fromRGB(math.floor(255*(1-pct)), math.floor(255*pct), 40)
        else d.hp.Visible = false; d.hpbg.Visible = false end

        -- Trace
        if S.ESP_Trace then
            d.trace.Visible = true
            d.trace.From    = Vector2.new(vp.X/2, vp.Y)
            d.trace.To      = Vector2.new(midX, botY)
            d.trace.Color   = S.ESP_Team and getTeamColor(p) or Color3.fromRGB(255,255,255)
        else d.trace.Visible = false end
    end

    for p, _ in pairs(espData) do
        if not p.Parent or not espCache[p] then removeESP(p) end
    end
end

