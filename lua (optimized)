-- ==================== NOCLIP PUNCH (FIXED) ====================
local punchBusy = false
local punchConnection = nil

local function noclipAll()
    local char = LocalPlayer.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
end

local function doNoclipPunch()
    if punchBusy then return end
    punchBusy = true

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not root or not hum then
        punchBusy = false
        return
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { char }
    params.IgnoreWater = true
    params.RespectCanCollide = false

    local dirs = {
        Vector3.new(1,0,0), Vector3.new(-1,0,0),
        Vector3.new(0,1,0), Vector3.new(0,-1,0),
        Vector3.new(0,0,1), Vector3.new(0,0,-1),
    }

    local near = false
    for _, d in ipairs(dirs) do
        local result = workspace:Raycast(root.Position, d * 4, params)
        if result and result.Instance then
            near = true
            break
        end
    end

    if not near then
        notify("No wall nearby", Theme.TEXT_DIM)
        punchBusy = false
        return
    end

    task.wait(0.3)

    local stillNear = false
    for _, d in ipairs(dirs) do
        local result = workspace:Raycast(root.Position, d * 5, params)
        if result and result.Instance then
            stillNear = true
            break
        end
    end

    if not stillNear then
        punchBusy = false
        return
    end

    noclipAll()

    local oldAutoRotate = hum.AutoRotate
    local oldPlatformStand = hum.PlatformStand
    hum.PlatformStand = true
    hum.AutoRotate = false

    local startTime = tick()
    local PUNCH_WINDOW = 0.25
    if punchConnection then punchConnection:Disconnect() end
    punchConnection = RunService.PreSimulation:Connect(function()
        if tick() - startTime > PUNCH_WINDOW then
            if punchConnection then
                punchConnection:Disconnect()
                punchConnection = nil
            end
            return
        end
        noclipAll()
    end)

    task.wait(PUNCH_WINDOW + 0.05)

    if punchConnection then
        punchConnection:Disconnect()
        punchConnection = nil
    end
    if char and char.Parent then
        hum.PlatformStand = oldPlatformStand
        hum.AutoRotate = oldAutoRotate
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                if not SilentAimSettings.NoclipEnabled then
                    part.CanCollide = true
                end
            end
        end
        local rp = char:FindFirstChild("HumanoidRootPart")
        if rp then rp.CanCollide = false end
    end

    punchBusy = false
end
