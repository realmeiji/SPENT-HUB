-- ESP (throttled)
local espCache = {}
local ESP_TICK = 1 / 20
local HIGHLIGHT_TICK = 0.25
local LOCK_TICK = 0.15
local DISTANCE_CULL = 1.2

local lastESP, lastHL, lastLock = 0, 0, 0
local lockedChar = nil

local function isLocked(ch)
    local now = tick()
    if now - lastLock >= LOCK_TICK then
        lastLock = now
        lockedChar = (currentTarget and currentTarget.Parent) or nil
    end
    return lockedChar == ch
end

local function mkESP(player)
    local d = {
        name = Drawing.new("Text"),
        hpBack = Drawing.new("Line"),
        hpBar = Drawing.new("Line"),
        trace = Drawing.new("Line"),
        hl = nil,
    }
    d.name.Size = 13
    d.name.Center = true
    d.name.Outline = true
    d.name.Color = Color3.fromRGB(255, 255, 255)
    d.name.Visible = false
    d.hpBack.Thickness = 3
    d.hpBack.Color = Color3.fromRGB(30, 30, 30)
    d.hpBack.Visible = false
    d.hpBar.Thickness = 3
    d.hpBar.Color = Color3.fromRGB(80, 255, 100)
    d.hpBar.Visible = false
    d.trace.Thickness = 1.5
    d.trace.Color = Color3.fromRGB(255, 255, 255)
    d.trace.Visible = false
    espCache[player] = d
    return d
end

local function clearESP(player)
    local d = espCache[player]
    if not d then return end
    for k, obj in pairs(d) do
        if k ~= "lastUpdate" and typeof(obj) == "userdata" then
            pcall(function() obj:Remove() end)
        end
    end
    espCache[player] = nil
end

Players.PlayerRemoving:Connect(function(p) clearESP(p) end)

local function hideESP(d)
    if d.name.Visible then d.name.Visible = false end
    if d.hpBack.Visible then d.hpBack.Visible = false end
    if d.hpBar.Visible then d.hpBar.Visible = false end
    if d.trace.Visible then d.trace.Visible = false end
end

local function updateESP()
    local now = tick()
    if now - lastESP < ESP_TICK then return end
    lastESP = now
    local canHL = (now - lastHL) >= HIGHLIGHT_TICK
    if canHL then lastHL = now end

    local camPos = Camera.CFrame.Position
    local vp = Camera.ViewportSize
    local cx, vpy = vp.X / 2, vp.Y
    local maxD = SilentAimSettings.ESP_MaxDistance * DISTANCE_CULL
    local enabled = SilentAimSettings.ESP_Enabled

    for _, player in ipairs(cachedPlayers) do
        if player == LocalPlayer then continue end
        if isWhitelisted(player) then
            local d = espCache[player]
            if d then hideESP(d) end
            continue
        end
        local d = espCache[player]
        local char = player.Character

        if not enabled then
            if d then hideESP(d) end
            if canHL and char then
                local hl = char:FindFirstChild("SpentHubHL")
                if hl then hl:Destroy() end
            end
            continue
        end

        if not char then
            if d then hideESP(d) end
            continue
        end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then
            if d then hideESP(d) end
            continue
        end

        local dist = (camPos - hrp.Position).Magnitude
        if dist > maxD then
            if d then hideESP(d) end
            if canHL then
                local hl = char:FindFirstChild("SpentHubHL")
                if hl then hl:Destroy() end
            end
            continue
        end

        if not d then d = mkESP(player) end

        local head = char:FindFirstChild("Head") or hrp
        local sh, on = WorldToViewportPoint(Camera, head.Position + Vector3.new(0, 1.5, 0))
        if not on then hideESP(d) continue end

        if SilentAimSettings.ESP_Name then
            if not d.name.Visible then d.name.Visible = true end
            d.name.Text = player.DisplayName
            d.name.Position = Vector2.new(sh.X, sh.Y - 20)
            d.name.Color = SilentAimSettings.ESP_NameColor
        elseif d.name.Visible then
            d.name.Visible = false
        end

        if SilentAimSettings.ESP_Health then
            local topY = sh.Y - 32
            if not d.hpBack.Visible then d.hpBack.Visible = true end
            if not d.hpBar.Visible then d.hpBar.Visible = true end
            d.hpBack.From = Vector2.new(sh.X - 28, topY)
            d.hpBack.To = Vector2.new(sh.X + 28, topY)
            local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
            d.hpBar.From = Vector2.new(sh.X - 28, topY)
            d.hpBar.To = Vector2.new(sh.X - 28 + 56 * pct, topY)
            d.hpBar.Color = SilentAimSettings.ESP_HPColor
        else
            if d.hpBack.Visible then d.hpBack.Visible = false end
            if d.hpBar.Visible then d.hpBar.Visible = false end
        end

        if SilentAimSettings.ESP_Trace then
            if not d.trace.Visible then d.trace.Visible = true end
            d.trace.From = Vector2.new(cx, vpy)
            d.trace.To = Vector2.new(sh.X, sh.Y)
            local tc = SilentAimSettings.ESP_Team and getTeamColor(player) or SilentAimSettings.ESP_TraceColor
            if d.trace.Color ~= tc then d.trace.Color = tc end
        elseif d.trace.Visible then
            d.trace.Visible = false
        end

        if canHL then
            if SilentAimSettings.ESP_Highlight then
                local hl = char:FindFirstChild("SpentHubHL")
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "SpentHubHL"
                    hl.Adornee = char
                    hl.FillTransparency = 1
                    hl.OutlineTransparency = 0
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Parent = char
                end
                local want
                if isLocked(char) then want = TARGET_LOCK_COLOR
                elseif SilentAimSettings.ESP_Team then want = getTeamColor(player)
                else want = SilentAimSettings.ESP_HighlightColor end
                if hl.OutlineColor ~= want then hl.OutlineColor = want end
            else
                local hl = char:FindFirstChild("SpentHubHL")
                if hl then hl:Destroy() end
            end
        end
    end
end

