local InvCF, InvTrack, InvKey = nil, nil, "SpentHubInv"
local InvOrigT, InvOrigC = {}, {}
local function loadInvAnim(c)
    local h = c:FindFirstChildOfClass("Humanoid"); if not h then return end
    local a = h:FindFirstChildOfClass("Animator"); if not a then return end
    local r15 = h.RigType == Enum.HumanoidRigType.R15
    local an = Instance.new("Animation")
    an.AnimationId = r15 and "rbxassetid://18665825805" or "rbxassetid://215384594"
    local t = a:LoadAnimation(an)
    t.Priority = Enum.AnimationPriority.Action4
    t:Play(0, 0.001, 0)
    an:Destroy()
    task.delay(0, function() t.TimePosition = r15 and 1.95 or 0.4 end)
    return t
end
local function stopInvisible()
    pcall(function() RunService:UnbindFromRenderStep(InvKey) end)
    if InvTrack then InvTrack:Stop() InvTrack:Destroy() InvTrack = nil end
    local c = LocalPlayer.Character
    local r = c and c:FindFirstChild("HumanoidRootPart")
    if r and InvCF then
        r.CFrame = InvCF
        local v = r.AssemblyLinearVelocity
        r.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
    end
    InvCF = nil
    if c then
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") and p ~= r then
                if InvOrigT[p] ~= nil then p.Transparency = InvOrigT[p] end
                if InvOrigC[p] ~= nil then p.CanCollide = InvOrigC[p] end
            end
        end
        if r then r.Transparency = 0 end
    end
    table.clear(InvOrigT); table.clear(InvOrigC)
end
local function startInvisible()
    local c = LocalPlayer.Character; if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid")
    local r = c:FindFirstChild("HumanoidRootPart")
    if not h or not r then return end
    InvTrack = loadInvAnim(c)
    InvCF = nil
    table.clear(InvOrigT); table.clear(InvOrigC)
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") and p ~= r then
            InvOrigT[p] = p.Transparency; InvOrigC[p] = p.CanCollide
            p.Transparency = 0.5; p.CanCollide = false
        end
    end
    r.Transparency = 1
    pcall(function() RunService:UnbindFromRenderStep(InvKey) end)
    RunService:BindToRenderStep(InvKey, Enum.RenderPriority.Camera.Value - 1, function()
        if SilentAimSettings.InvisibleEnabled and InvCF and r.Parent then
            r.CFrame = InvCF
            if InvTrack then InvTrack:AdjustWeight(0.001) end
        end
    end)
end
RunService.Heartbeat:Connect(function()
    if not SilentAimSettings.InvisibleEnabled then return end
    local c = LocalPlayer.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    local r = c and c:FindFirstChild("HumanoidRootPart")
    if not h or not r then return end
    local r15 = h.RigType == Enum.HumanoidRigType.R15
    local off = h.HipHeight + (r.Size.Y / 2) - 1
    InvCF = r.CFrame
    r.CFrame = (r.CFrame - Vector3.new(0, off, 0)) * CFrame.Angles(math.rad(r15 and 180 or 90), 0, 0)
    local v = r.AssemblyLinearVelocity
    r.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
    if InvTrack then InvTrack:AdjustWeight(100) end
end)

