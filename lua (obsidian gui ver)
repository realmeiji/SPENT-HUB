UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end

    if input.KeyCode == Enum.KeyCode.RightAlt then
        SilentAimSettings.Enabled = not SilentAimSettings.Enabled
        Notify("Silent Aim " .. (SilentAimSettings.Enabled and "enabled" or "disabled"), Scheme.AccentColor)
        StatusLabel.Text = SilentAimSettings.Enabled and "● silent aim ON" or "● idle"
    end

    if input.KeyCode == Enum.KeyCode.RightShift then
        MainFrame.Visible = not MainFrame.Visible
        -- Remove reopen btn if it exists
        local rb = ScreenGui:FindFirstChild("ObsReopenBtn")
        if rb then rb:Destroy() end
    end

    if input.KeyCode == SilentAimSettings.FastSwitchHotkey then
        SilentAimSettings.FastSwitchEnabled = not SilentAimSettings.FastSwitchEnabled
        if SilentAimSettings.FastSwitchEnabled then startFastSwitch() else stopFastSwitch() end
        Notify("Fast Switch " .. (SilentAimSettings.FastSwitchEnabled and "on" or "off"), Scheme.AccentColor)
    end

    if input.KeyCode == Enum.KeyCode.F and SilentAimSettings.NoclipPunchEnabled then
        doNoclipPunch()
    end

    if input.KeyCode == Enum.KeyCode.End then
        pcall(function() ScreenGui:Destroy() end)
        pcall(function() fov_circle:Remove() end)
        pcall(function() mouse_box:Remove() end)
        stopNoclip(); stopNoclipPunch(); stopInvisible(); stopFastSwitch()
        for _, p in ipairs(Players:GetPlayers()) do
            local d = espData and espData[p]
            if d then
                pcall(function() d.name:Remove() end); pcall(function() d.hpbar:Remove() end)
                pcall(function() d.hpbarbg:Remove() end); pcall(function() d.trace:Remove() end)
                pcall(function() d.hl:Destroy() end)
            end
        end
        print("[SpentHub] Unloaded.")
    end
end)

