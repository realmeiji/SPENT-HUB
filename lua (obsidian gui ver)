local function MakeSlider(parent, text, min, max, default, callback)
    local holder = New("Frame", {
        Size = UDim2.new(1,0,0,52),
        BackgroundColor3 = Scheme.MainColor,
        BorderSizePixel = 0,
        ZIndex = 13, Parent = parent,
    })
    New("UICorner", { CornerRadius = UDim.new(0,6), Parent = holder })
    New("UIStroke", { Color = Scheme.OutlineColor, Thickness = 1, Parent = holder })

    local lbl = New("TextLabel", {
        Size = UDim2.new(1,-16,0,20),
        Position = UDim2.fromOffset(12,6),
        BackgroundTransparency = 1,
        Text = text .. ": " .. tostring(default),
        TextColor3 = Scheme.FontColor,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 14, Parent = holder,
    })

    local barBg = New("Frame", {
        Position = UDim2.new(0,12,0,30),
        Size = UDim2.new(1,-24,0,6),
        BackgroundColor3 = Scheme.OutlineColor,
        BorderSizePixel = 0,
        ZIndex = 14, Parent = holder,
    })
    New("UICorner", { CornerRadius = UDim.new(1,0), Parent = barBg })

    local pct = (default-min)/(max-min)
    local fill = New("Frame", {
        Size = UDim2.fromScale(math.clamp(pct,0,1),1),
        BackgroundColor3 = Scheme.AccentColor,
        BorderSizePixel = 0,
        ZIndex = 15, Parent = barBg,
    })
    New("UICorner", { CornerRadius = UDim.new(1,0), Parent = fill })

    -- drag handle
    local handle = New("Frame", {
        AnchorPoint = Vector2.new(0.5,0.5),
        Size = UDim2.fromOffset(14,14),
        Position = UDim2.new(math.clamp(pct,0,1),0,0.5,0),
        BackgroundColor3 = Scheme.White,
        BorderSizePixel = 0,
        ZIndex = 16, Parent = barBg,
    })
    New("UICorner", { CornerRadius = UDim.new(1,0), Parent = handle })
    New("UIStroke", { Color = Scheme.AccentColor, Thickness = 1.5, Parent = handle })

    local dragging = false
    local clickBtn = New("TextButton", {
        Size = UDim2.fromScale(1,1), BackgroundTransparency = 1,
        Text = "", ZIndex = 17, Parent = barBg,
    })

    local function setFromMouse(x)
        local rel = math.clamp((x - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + (max-min)*rel)
        fill.Size = UDim2.fromScale(rel,1)
        handle.Position = UDim2.new(rel,0,0.5,0)
        lbl.Text = text .. ": " .. tostring(val)
        pcall(callback, val)
    end

    clickBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or
           input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setFromMouse(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or
           input.UserInputType == Enum.UserInputType.Touch) then
            setFromMouse(input.Position.X)
        end
    end)

    return holder
end

