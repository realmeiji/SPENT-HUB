        if p.Team and p.Team.TeamColor then return p.Team.TeamColor.Color end
        local c = p.Character
        if c then local bc = c:FindFirstChildOfClass("BodyColors") if bc then return bc.HeadColor3 end end
        return ACCENT
    end)
    return (ok and col) or ACCENT
end

local function matchesTeam(P)
    if not P.Team then return true end
    local n = P.Team.Name
    if n == "Guards" and not SilentAimSettings.TargetCop then return false end
    if n == "Inmates" and not SilentAimSettings.TargetInmate then return false end
    if n == "Criminals" and not SilentAimSettings.TargetCriminal then return false end
    return true
end

local currentTarget = nil
local function getClosestPlayer()
    if not SilentAimSettings.TargetPart then return end
    local Closest, Dist
    local origin = getAimOrigin()
    for _, Player in next, GetPlayers(Players) do
        if Player == LocalPlayer then continue end
        if isWhitelisted(Player) then continue end
        if SilentAimSettings.TeamCheck and Player.Team == LocalPlayer.Team then continue end
        if not matchesTeam(Player) then continue end
        if SilentAimSettings.ForcefieldCheck and HasForcefield(Player) then continue end
        if not matchesTargetingMode(Player) then continue end
        local C = Player.Character
        if not C then continue end
        if SilentAimSettings.VisibleCheck and not IsPlayerVisible(Player) then continue end
        local HRP = FindFirstChild(C, "HumanoidRootPart")
        local Hum = FindFirstChild(C, "Humanoid")
        if not HRP or not Hum or Hum.Health <= 0 then continue end
        local SP, On = getPositionOnScreen(HRP.Position)
        if not On then continue end
        local D = (origin - SP).Magnitude
        if D <= (Dist or SilentAimSettings.FOVRadius or 2000) then
            local tp = SilentAimSettings.TargetPart
            local part
            if tp == "Random" then part = C[ValidTargetParts[math.random(1, #ValidTargetParts)]]
            else part = C[tp] end
            Closest = part; Dist = D
        end
    end
    return Closest
end

