local function getRedirectedDirectionForAutoShoot(Origin)
    local pos = getSmoothedTargetPosition(); if not pos then return nil end
    local OD = (pos - Origin).Magnitude; if OD == 0 then OD = 1000 end
    local S = currentTarget.Size
    local T = pos + Vector3.new((math.random()-0.5)*(S.X+2)*0.2, (math.random()-0.5)*(S.Y+2)*0.2, (math.random()-0.5)*(S.Z+2)*0.2)
    local ND = (T - Origin).Magnitude; if ND == 0 then return nil end
    return (T - Origin).Unit * math.max(OD, ND)
end

local function updateAmmoLabel(w, ammo)
    local ok, gf = pcall(function()
        return LocalPlayer.PlayerGui:WaitForChild("Home", 3):WaitForChild("hud", 3)
            :WaitForChild("BottomRightFrame", 3):WaitForChild("GunFrame", 3)
    end)
    if not ok or not gf then return end
    local bl = gf:FindFirstChild("BulletsLabel"); if not bl then return end
    local b = w:GetAttribute("Behavior")
    if b == "Sniper" then bl.Text = ammo .. " | " .. (w:GetAttribute("StoredAmmo") or 0)
    else bl.Text = ammo .. "/" .. (w:GetAttribute("MaxAmmo") or ammo) end
end

local function castPelletRayAutoShoot(w, origin, aimPoint, spreadRadius)
    local roll = math.random()
    local b = w:GetAttribute("Behavior")
    if b == "Sniper" or b == "Shotgun" then roll = math.sqrt(roll) end
    local range = w:GetAttribute("Range") or 1000
    local look = CFrame.new(origin, aimPoint)
    local ang = 360 - 720 * math.random()
    local dir = (look * CFrame.Angles(0, 0, math.rad(ang)) * CFrame.Angles(0, roll * spreadRadius, 0)).LookVector * range
    AutoShootRaycastInProgress = true
    local res = workspace:Raycast(origin, dir, autoShootParams)
    AutoShootRaycastInProgress = false
    return (res and res.Instance), (res and res.Position or (origin + dir))
end

local function performAutoShot(w)
    if not w or not shootRemote then return end
    if not currentTarget or not currentTarget.Parent then return end
    local b = w:GetAttribute("Behavior")
    local reload = w:GetAttribute("Local_ReloadSession") or 0
    local ammo = w:GetAttribute("Local_CurrentAmmo") or 0
    if reload ~= 0 or ammo <= 0 then return end
    local c = LocalPlayer.Character
    local head = c and c:FindFirstChild("Head"); if not head then return end
    autoShootParams.FilterDescendantsInstances = {c}
    local aim = currentTarget.Position
    local rd = getRedirectedDirectionForAutoShoot(head.Position)
    if rd then aim = head.Position + rd end
    local pcount = w:GetAttribute("ProjectileCount") or 1
    local spread = w:GetAttribute("SpreadRadius") or 0
    local muzzle = w:FindFirstChild("Muzzle")
    local mpos = muzzle and muzzle.Position or head.Position
    local bd = {}
    for i = 1, pcount do
        local hi, hp = castPelletRayAutoShoot(w, head.Position, aim, spread)
        table.insert(bd, {head.Position, hp, hi})
        if AutoShootGunTracers then
            pcall(function()
                if b == "Sniper" then AutoShootGunTracers.createSniper(mpos, hp)
                elseif b == "Taser" then AutoShootGunTracers.createTaser(mpos, hp)
                else AutoShootGunTracers.createBullet(mpos, hp) end
            end)
        end
    end
    shootRemote:FireServer(bd)
    local na = ammo - 1
    w:SetAttribute("Local_CurrentAmmo", na)
    updateAmmoLabel(w, na)
    pcall(function()
        local h = w:FindFirstChild("Handle")
        if h then
            local ss = h:FindFirstChild("ShootSound")
            if ss then
                local cl = ss:Clone(); cl.Parent = Camera; cl.Playing = true
                task.delay(5, function() pcall(function() cl:Destroy() end) end)
            end
            local fl = h:FindFirstChild("Flare")
            if fl then fl.Enabled = true task.delay(0.05, function() if fl then fl.Enabled = false end end) end
        end
    end)
end

