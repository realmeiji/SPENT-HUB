        SilentAimSettings.FastSwitchEnabled = s
        if s then startFastSwitch() else stopFastSwitch() end
        Notify("Fast Switch " .. (s and "enabled" or "disabled"), s and Scheme.AccentColor or Scheme.FontDim)
    end, "Cycle through selected guns automatically")
    MakeKeybind(page, "Toggle Hotkey", SilentAimSettings.FastSwitchHotkey, function(newKey)
        SilentAimSettings.FastSwitchHotkey = newKey
        Notify("Fast Switch hotkey: " .. newKey.Name, Scheme.AccentColor)
    end)
    MakeSlider(page, "Switch Speed (ms×10)", 1, 50, math.floor(SilentAimSettings.FastSwitchDelay*100), function(v)
        SilentAimSettings.FastSwitchDelay = v/100
    end)

    MakeSection(page, "GUN LIST")

    local gunContainer = New("Frame", {
        Size = UDim2.new(1,0,0,10),
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.Y,
        ZIndex = 13, Parent = page,
    })
    local gunLayout = New("UIListLayout", { Padding = UDim.new(0,4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = gunContainer })

    local function RefreshGunList()
        for _, c in ipairs(gunContainer:GetChildren()) do
            if c:IsA("Frame") then c:Destroy() end
        end
        local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
        local char = LocalPlayer.Character
        for _, gunName in ipairs(FIXED_GUN_LIST) do
            local inBackpack = backpack and backpack:FindFirstChild(gunName) ~= nil
            local equipped   = char and char:FindFirstChild(gunName) ~= nil
            local available  = inBackpack or equipped
            local selected   = table.find(SilentAimSettings.FastSwitchList, gunName) ~= nil

            local row = New("Frame", {
                Size = UDim2.new(1,0,0,ELEM_H),
                BackgroundColor3 = Scheme.MainColor,
                BorderSizePixel = 0, ZIndex = 13, Parent = gunContainer,
            })
            New("UICorner", { CornerRadius = UDim.new(0,6), Parent = row })
            local rowStroke = New("UIStroke", {
                Color = selected and Scheme.AccentColor or Scheme.OutlineColor,
                Thickness = 1, Parent = row,
            })

            New("TextLabel", {
                Size = UDim2.new(1,-54,1,0), Position = UDim2.fromOffset(12,0),
                BackgroundTransparency = 1,
                Text = gunName .. (available and "" or "  <font color='#666'>✕ not in backpack</font>"),
                RichText = true,
                TextColor3 = selected and Scheme.AccentColor or (available and Scheme.FontColor or Scheme.FontMuted),
                Font = Enum.Font.GothamMedium, TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = 14, Parent = row,
            })

            -- mini toggle
            local TRACK_W,TRACK_H = 30,16; local DOT_SZ = 10
            local track = New("Frame", {
                AnchorPoint = Vector2.new(1,0.5),
                Size = UDim2.fromOffset(TRACK_W,TRACK_H),
                Position = UDim2.new(1,-12,0.5,0),
                BackgroundColor3 = selected and Scheme.AccentColor or Scheme.OutlineColor,
                BorderSizePixel = 0, ZIndex = 14, Parent = row,
            })
            New("UICorner", { CornerRadius = UDim.new(1,0), Parent = track })
            local dot = New("Frame", {
                Size = UDim2.fromOffset(DOT_SZ,DOT_SZ),
                Position = selected and UDim2.fromOffset(TRACK_W-DOT_SZ-3,3) or UDim2.fromOffset(3,3),
                BackgroundColor3 = Scheme.White, BorderSizePixel = 0, ZIndex = 15, Parent = track,
            })
            New("UICorner", { CornerRadius = UDim.new(1,0), Parent = dot })

            local state = selected
            local clickBtn = New("TextButton", {
                Size = UDim2.fromScale(1,1), BackgroundTransparency = 1,
                Text = "", ZIndex = 15, Parent = row,
            })
            clickBtn.MouseButton1Click:Connect(function()
                state = not state
                local found = table.find(SilentAimSettings.FastSwitchList, gunName)
                if state and not found then
                    table.insert(SilentAimSettings.FastSwitchList, gunName)
                elseif not state and found then
                    table.remove(SilentAimSettings.FastSwitchList, found)
                end
                Tween(track, TweenInfo_Fast, { BackgroundColor3 = state and Scheme.AccentColor or Scheme.OutlineColor })
                Tween(dot, TweenInfo_Fast, {
                    Position = state and UDim2.fromOffset(TRACK_W-DOT_SZ-3,3) or UDim2.fromOffset(3,3)
                })
                rowStroke.Color = state and Scheme.AccentColor or Scheme.OutlineColor
                Notify(gunName .. " " .. (state and "added" or "removed"), Scheme.AccentColor)
            end)

            row.MouseEnter:Connect(function()
                Tween(row, TweenInfo_Fast, { BackgroundColor3 = Scheme.PanelColor })
            end)
            row.MouseLeave:Connect(function()
                Tween(row, TweenInfo_Fast, { BackgroundColor3 = Scheme.MainColor })
            end)
        end
    end

    MakeButton(page, "Refresh Gun List", RefreshGunList)
    RefreshGunList()

    local function hookBackpack()
        local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
        if bp then
            bp.ChildAdded:Connect(function() task.wait(0.1); RefreshGunList() end)
            bp.ChildRemoved:Connect(function() task.wait(0.1); RefreshGunList() end)
        end
    end
    hookBackpack()
    LocalPlayer.CharacterAdded:Connect(function()
        task.wait(1); hookBackpack(); RefreshGunList()
    end)
end

