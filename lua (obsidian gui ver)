local FIXED_GUN_LIST = {"M9","Revolver","Remington 870","MP5","M4A1","M700","AK-47"}
local function BuildFastSwitchPage()
    local page = MakeTabPage("fastswitch")
    local lay = New("UIListLayout", { Padding = UDim.new(0,8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = page })

    MakeSection(page, "FAST SWITCH")
