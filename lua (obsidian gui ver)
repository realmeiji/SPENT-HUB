-- NOCLIP PUNCH
local punchBusy = false
local function doNoclipPunch()
    if punchBusy then return end
    punchBusy = true
    task.spawn(function()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not char or not root then punchBusy = false return end

        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { char }
        params.IgnoreWater = true
        local dirs = {
            Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0),
            Vector3.new(0, 1, 0), Vector3.new(0, -1, 0),
            Vector3.new(0, 0, 1), Vector3.new(0, 0, -1),
        }
        local near = false
        for _, d in ipairs(dirs) do
            if workspace:Raycast(root.Position, d.Unit * 3, params) then
                near = true
                break
            end
        end
        if not near then
            punchBusy = false
            return
        end

        task.wait(0.3)

        local stillNear = false
        for _, d in ipairs(dirs) do
            if workspace:Raycast(root.Position, d.Unit * 3, params) then
                stillNear = true
                break
            end
        end
        if not stillNear then
            punchBusy = false
            return
        end

        noclipStep()
        local conn
        conn = RunService.Stepped:Connect(function()
            noclipStep()
        end)
        task.wait(0.2)
        conn:Disconnect()
        punchBusy = false
    end)
end

