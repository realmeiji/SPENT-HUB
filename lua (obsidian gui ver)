        ZIndex = 13, Parent = holder,
    })
    New("UICorner", { CornerRadius = UDim.new(0,6), Parent = btn })

    -- Tooltip label (appears to the right on hover)
    local ttip = New("TextLabel", {
        AnchorPoint = Vector2.new(0,0.5),
        Position = UDim2.new(1,TAB_W+6,0.5,0),
        Size = UDim2.fromOffset(0,24),
        BackgroundColor3 = Scheme.PanelColor,
        BackgroundTransparency = 1,
        Text = def.tooltip,
        TextColor3 = Scheme.FontColor,
        Font = Enum.Font.GothamMedium,
        TextSize = 11,
        TextTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 20, Parent = ScreenGui, -- parent to ScreenGui so it overlays everything
        Visible = false,
    })
    New("UICorner", { CornerRadius = UDim.new(0,4), Parent = ttip })
    New("UIStroke", { Color = Scheme.OutlineColor, Thickness = 1, Parent = ttip })
    New("UIPadding", { PaddingLeft = UDim.new(0,8), PaddingRight = UDim.new(0,8), Parent = ttip })

    btn.MouseEnter:Connect(function()
        if ActiveTab ~= def.key then
            Tween(btn, TweenInfo_Fast, { BackgroundTransparency = 0.5, TextColor3 = Scheme.FontDim })
        end
        -- Position tooltip relative to screen
        local absPos = btn.AbsolutePosition
        local absSize = btn.AbsoluteSize
        local X,Y = GetTextBounds(def.tooltip, Font.fromEnum(Enum.Font.GothamMedium), 11)
        ttip.Size = UDim2.fromOffset(X+16, 24)
        ttip.Position = UDim2.fromOffset(absPos.X + absSize.X + 6, absPos.Y + absSize.Y/2 - 12)
        ttip.Visible = true
        Tween(ttip, TweenInfo_Fast, { TextTransparency = 0, BackgroundTransparency = 0 })
    end)
    btn.MouseLeave:Connect(function()
        if ActiveTab ~= def.key then
            Tween(btn, TweenInfo_Fast, { BackgroundTransparency = 1, TextColor3 = Scheme.FontMuted })
        end
        Tween(ttip, TweenInfo_Fast, { TextTransparency = 1, BackgroundTransparency = 1 })
        task.delay(0.15, function() ttip.Visible = false end)
    end)

    TabBtns[def.key] = { holder = holder, btn = btn, indicator = indicator, ttip = ttip }
    return btn
end

-- Create content page frame
local function MakeTabPage(key)
    local page = New("Frame", {
        Size = UDim2.fromScale(1,1),
        BackgroundTransparency = 1,
        Visible = false,
        ZIndex = 12, Parent = ContentScroll,
    })
    TabPages[key] = page
    return page
end

local function SelectTab(key)
    if ActiveTab == key then return end
    ActiveTab = key

    for k, pg in pairs(TabPages) do
        pg.Visible = k == key
    end
    for k, tb in pairs(TabBtns) do
        local isActive = k == key
        Tween(tb.btn, TweenInfo_Fast, {
            BackgroundTransparency = isActive and 0 or 1,
            TextColor3 = isActive and Scheme.AccentColor or Scheme.FontMuted,
            BackgroundColor3 = isActive and Scheme.MainColor or Scheme.PanelColor,
        })
        Tween(tb.indicator, TweenInfo_Fast, {
            BackgroundTransparency = isActive and 0 or 1,
        })
    end

    -- Update page title
    for _, def in ipairs(TabDefs) do
        if def.key == key then
            PageTitle.Text = string.upper(def.tooltip)
            break
        end
    end

    -- Animate accent bar
    PageHeaderAccent.Size = UDim2.fromOffset(3,0)
    Tween(PageHeaderAccent, TweenInfo_Med, { Size = UDim2.fromOffset(3,22) })
end

-- Build all tab buttons
for i, def in ipairs(TabDefs) do
    local btn = MakeTabBtn(def, i)
    btn.MouseButton1Click:Connect(function() SelectTab(def.key) end)
end

