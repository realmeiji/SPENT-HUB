local function IsPlayerVisible(Player)
    local C = Player.Character; local LC = LocalPlayer.Character
    if not (C and LC) then return false end
    local Root = FindFirstChild(C, SilentAimSettings.TargetPart) or FindFirstChild(C, "HumanoidRootPart")
    if not Root then return false end
    local CastPoints = {Root.Position, LC, C}
    return #GetPartsObscuringTarget(Camera, CastPoints, {LC, C}) == 0
end

local function HasForcefield(P)
    local c = P.Character
    return c and c:FindFirstChildOfClass("ForceField") ~= nil
end

local function matchesTargetingMode(P)
    local mode = SilentAimSettings.TargetingMode
    if mode == "Manual" then return true end
    if P.Team then
        local n = P.Team.Name
        if n == "Guards" or n == "Criminals" then return true end
        if n == "Inmates" then
            local c = P.Character
            if not c then return false end
            if mode == "Hostile" then return c:GetAttribute("Hostile") == true
            elseif mode == "Trespassing" then return c:GetAttribute("Trespassing") == true end
        end
    end
    return mode == "Manual"
end

local function getTeamColor(p)
