-- ESP SYSTEM
-- ============================================================
local espData = {}

local function createESPData()
    local d = {}
    d.name = Drawing.new("Text"); d.name.Visible=false; d.name.Font=2
    d.name.Center=true; d.name.Outline=true; d.name.ZIndex=10
    d.hpbarbg = Drawing.new("Square"); d.hpbarbg.Visible=false
    d.hpbarbg.Filled=true; d.hpbarbg.Thickness=0; d.hpbarbg.ZIndex=10
    d.hpbar = Drawing.new("Square"); d.hpbar.Visible=false
    d.hpbar.Filled=true; d.hpbar.Thickness=0; d.hpbar.ZIndex=11
    d.trace = Drawing.new("Line"); d.trace.Visible=false; d.trace.ZIndex=9; d.trace.Thickness=1
    d.hl = Instance.new("Highlight")
    d.hl.FillColor=Scheme.AccentColor; d.hl.OutlineColor=Scheme.AccentColor
    d.hl.FillTransparency=0.55; d.hl.OutlineTransparency=0
    d.hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; d.hl.Enabled=false
    return d
end

local function hideESPData(d)
    if not d then return end
    d.name.Visible=false; d.hpbar.Visible=false; d.hpbarbg.Visible=false; d.trace.Visible=false
    if d.hl then d.hl.Enabled=false end
end

local function removeESPData(plr)
    local d=espData[plr]; if not d then return end
    pcall(function() d.name:Remove() end); pcall(function() d.hpbar:Remove() end)
    pcall(function() d.hpbarbg:Remove() end); pcall(function() d.trace:Remove() end)
    pcall(function() d.hl:Destroy() end)
    espData[plr]=nil
end

local espLastLogic=0; local espCache={}
local ESP_LOGIC_INTERVAL=0.05

local function updateESPLogic()
    if not SilentAimSettings.ESP_Enabled then
        for _,d in pairs(espData) do hideESPData(d) end; return
    end
    local myC=LocalPlayer.Character; local myR=myC and myC:FindFirstChild("HumanoidRootPart")
    local camPos=myR and myR.Position or Camera.CFrame.Position
    local maxDist=SilentAimSettings.ESP_MaxDistance
    local teamColors=SilentAimSettings.ESP_Team; local myTeam=LocalPlayer.Team
    local vp=Camera.ViewportSize

    table.clear(espCache)
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LocalPlayer then continue end
        local c=p.Character; local h=c and c:FindFirstChildOfClass("Humanoid")
        local r=c and c:FindFirstChild("HumanoidRootPart")
        if c and h and r and h.Health>0 then espCache[p]={c=c,h=h,r=r,head=c:FindFirstChild("Head")} end
    end

    for p,info in pairs(espCache) do
        local c,h,r,head=info.c,info.h,info.r,info.head
        local d=espData[p]; if not d then d=createESPData(); espData[p]=d end

        if teamColors and p.Team and p.Team==myTeam then hideESPData(d); continue end
        local dist=(r.Position-camPos).Magnitude
        if dist>maxDist then hideESPData(d); continue end

        local headPos=head and head.Position or (r.Position+Vector3.new(0,2.5,0))
        local feetPos=r.Position-Vector3.new(0,2.8,0)
        local hVec3=Camera:WorldToViewportPoint(headPos)
        local fVec3=Camera:WorldToViewportPoint(feetPos)
        if hVec3.Z<=0 and fVec3.Z<=0 then hideESPData(d); continue end

        local hs=Vector2.new(hVec3.X,hVec3.Y); local fs=Vector2.new(fVec3.X,fVec3.Y)
        local refX=hVec3.Z>0 and hs.X or fs.X; local refY=hVec3.Z>0 and hs.Y or fs.Y
        if refX<-200 or refX>vp.X+200 or refY<-200 or refY>vp.Y+200 then hideESPData(d); continue end

        local bh=math.clamp(math.abs(hs.Y-fs.Y),12,400)
        local topY=math.min(hs.Y,fs.Y); local botY=topY+bh; local midX=hs.X

        if SilentAimSettings.ESP_Highlight then
            local color=teamColors and getTeamColor(p) or Scheme.AccentColor
            if d.hl.Adornee~=c then d.hl.Adornee=c end
            if d.hl.Parent~=c then d.hl.Parent=c end
            d.hl.FillColor=color; d.hl.OutlineColor=color; d.hl.Enabled=true
        else d.hl.Enabled=false end

        if SilentAimSettings.ESP_Name then
            d.name.Visible=true
            d.name.Text=string.format("%s [%d]",p.Name,math.floor(dist))
            d.name.Color=SilentAimSettings.ESP_NameColor
            d.name.Size=math.clamp(13-dist/120,8,14)
            d.name.Position=Vector2.new(midX,topY-16)
        else d.name.Visible=false end

        if SilentAimSettings.ESP_Health then
            local pct=math.clamp(h.Health/math.max(h.MaxHealth,1),0,1)
            local bwd=math.max(3,math.min(6,bh*0.06))
            local bx=midX-(bh*0.275)-bwd-4
            d.hpbarbg.Visible=true; d.hpbarbg.Position=Vector2.new(bx,topY)
            d.hpbarbg.Size=Vector2.new(bwd,bh); d.hpbarbg.Color=Color3.fromRGB(20,20,20)
            local fillH=bh*pct
            d.hpbar.Visible=true; d.hpbar.Position=Vector2.new(bx,botY-fillH)
            d.hpbar.Size=Vector2.new(bwd,fillH)
            d.hpbar.Color=Color3.fromRGB(math.floor(255*(1-pct)),math.floor(255*pct),40)
        else d.hpbar.Visible=false; d.hpbarbg.Visible=false end

        if SilentAimSettings.ESP_Trace then
            d.trace.Visible=true; d.trace.From=Vector2.new(vp.X/2,vp.Y)
            d.trace.To=Vector2.new(midX,botY)
            d.trace.Color=teamColors and getTeamColor(p) or SilentAimSettings.ESP_TraceColor
        else d.trace.Visible=false end
    end

    for plr,_ in pairs(espData) do
        if not plr.Parent or not espCache[plr] then removeESPData(plr) end
    end
end

Players.PlayerRemoving:Connect(function(plr)
    task.wait(0.1); removeESPData(plr)
end)

