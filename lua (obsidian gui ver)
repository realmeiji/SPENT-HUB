    for _, p in ipairs(Players:GetPlayers()) do removeESPData(p) end
end)

local MainFileName = "UniversalSilentAim"
local FileToSave = ""

do
    if not isfolder(MainFileName) then makefolder(MainFileName) end
    local sub = MainFileName .. "/" .. tostring(game.PlaceId)
    if not isfolder(sub) then makefolder(sub) end
end

local Files = listfiles(MainFileName .. "/" .. tostring(game.PlaceId))

local function GetFiles()
    local out = {}
    for i = 1, #Files do
        local file = Files[i]
        if file:sub(-4) == ".lua" then
            local pos = file:find(".lua", 1, true)
            local start = pos
            local ch = file:sub(pos, pos)
            while ch ~= "/" and ch ~= "\\" and ch ~= "" do
                pos = pos - 1
                ch = file:sub(pos, pos)
            end
            if ch == "/" or ch == "\\" then table.insert(out, file:sub(pos + 1, start - 1)) end
        end
    end
    return out
end

local function UpdateFile(FileName)
    local serializable = {}
    for k, v in pairs(SilentAimSettings) do
        if typeof(v) == "Color3" then
            serializable[k] = {R = v.R, G = v.G, B = v.B, isColor = true}
        elseif typeof(v) == "EnumItem" then
            serializable[k] = v.Name
        elseif typeof(v) == "table" then
            serializable[k] = v
        else
            serializable[k] = v
        end
    end
    writefile(MainFileName .. "/" .. tostring(game.PlaceId) .. "/" .. FileName .. ".lua", HttpService:JSONEncode(serializable))
end

local function LoadFile(FileName)
    local data = HttpService:JSONDecode(readfile(MainFileName .. "/" .. tostring(game.PlaceId) .. "/" .. FileName .. ".lua"))
    for k, v in pairs(data) do
        if typeof(v) == "table" and v.isColor then
            SilentAimSettings[k] = Color3.new(v.R, v.G, v.B)
        elseif typeof(v) == "string" and k == "FastSwitchHotkey" then
            pcall(function() SilentAimSettings[k] = Enum.KeyCode[v] end)
        else
            SilentAimSettings[k] = v
        end
    end
end

